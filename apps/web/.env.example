# Server-only URL. Never put database credentials in NEXT_PUBLIC_* variables.
CCE_API_BASE_URL=http://127.0.0.1:8000
# Get the local PUBLISHABLE_KEY from `supabase status -o json`. Never use a secret key.
CCE_SUPABASE_URL=http://127.0.0.1:54321
CCE_SUPABASE_PUBLISHABLE_KEY=
CCE_WEB_ORIGIN=http://127.0.0.1:3100
