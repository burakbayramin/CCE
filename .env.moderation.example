# Copy to .env.moderation (git-ignored); pass it explicitly with Compose --env-file.
# This is an opt-in local service template, not model/production acceptance.
# The base image has no real scanner/model. A reviewed adapter image is required.
CCE_ENVIRONMENT=local
CCE_WORKER_DATABASE_URL=postgresql+psycopg://cce_worker_cpu:CHANGE_ME@host.docker.internal:54322/postgres
CCE_STORAGE_URL=http://host.docker.internal:54321
CCE_SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
CCE_MODERATION_AUTH_USER_ID=CHANGE_ME
CCE_MODERATION_AUTH_EMAIL=CHANGE_ME
CCE_MODERATION_AUTH_PASSWORD=CHANGE_ME
CCE_MODERATION_SCANNER_FACTORY=CHANGE_ME
CCE_MODERATION_IDLE_SECONDS=2
CCE_MODERATION_STARTUP_SECONDS=120
CCE_MODERATION_TIMEOUT_SECONDS=120
